# Copia este fichero a .env y ajusta los valores si lo necesitas.

POSTGRES_USER=dhub
POSTGRES_PASSWORD=dhub
POSTGRES_DB=dhub

AUTH_USUARIO=coordinador
AUTH_PASSWORD=coordinador123
AUTH_NOMBRE=Coordinador Técnico

# Los valores de AUTH_* de arriba solo se usan para crear la cuenta la PRIMERA
# vez que arranca la aplicación (base de datos vacía). A partir de ahí la
# contraseña se gestiona desde la propia aplicación (Configuración > Mi cuenta)
# y persiste en la base de datos aunque reinicies los contenedores.

# Los datos de ejemplo solo se insertan si la base de datos está completamente
# vacía (nunca se repiten ni sobrescriben datos existentes). Ponlo a false si
# quieres desactivar el seed por completo, incluso en una base de datos nueva.
SEED_ENABLED=true
